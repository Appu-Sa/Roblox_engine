{
  "durationSeconds": 38.85,
  "durationInFrames": 1166,
  "beatTimings": {
    "b1": {
      "startSec": 0.15,
      "endSec": 2.776,
      "startFrame": 4,
      "endFrame": 83,
      "text": "In this world, everyone gets one hundred words a day."
    },
    "b2": {
      "startSec": 2.856,
      "endSec": 5.5,
      "startFrame": 86,
      "endFrame": 165,
      "text": "A counter above your head shows every word you have left."
    },
    "b3": {
      "startSec": 5.58,
      "endSec": 7.883,
      "startFrame": 167,
      "endFrame": 237,
      "text": "Spend them all, and you can't speak until midnight."
    },
    "b4": {
      "startSec": 7.963,
      "endSec": 9.998,
      "startFrame": 239,
      "endFrame": 300,
      "text": "Rich kids burn theirs on jokes and songs."
    },
    "b5": {
      "startSec": 10.078,
      "endSec": 13.142,
      "startFrame": 302,
      "endFrame": 394,
      "text": "My teacher makes us raise a finger for every word in class."
    },
    "b6": {
      "startSec": 13.212,
      "endSec": 15.675,
      "startFrame": 396,
      "endFrame": 470,
      "text": "The bully spends fifty words just to call me names."
    },
    "b7": {
      "startSec": 15.755,
      "endSec": 18.331,
      "startFrame": 473,
      "endFrame": 550,
      "text": "But me? I don't talk. I save every single word."
    },
    "b8": {
      "startSec": 18.412,
      "endSec": 20.246,
      "startFrame": 552,
      "endFrame": 607,
      "text": "The whole school calls me the Quiet Kid."
    },
    "b9": {
      "startSec": 20.316,
      "endSec": 23.283,
      "startFrame": 609,
      "endFrame": 699,
      "text": "Only my little sister thinks I'm saving up for something big."
    },
    "b10": {
      "startSec": 23.363,
      "endSec": 26.78,
      "startFrame": 701,
      "endFrame": 803,
      "text": "Then yesterday, she fell off the slide, and her counter hit zero."
    },
    "b11": {
      "startSec": 26.88,
      "endSec": 28.346,
      "startFrame": 806,
      "endFrame": 850,
      "text": "She couldn't even whisper for help."
    },
    "w1": {
      "startSec": 28.466,
      "endSec": 29.057,
      "startFrame": 854,
      "endFrame": 872,
      "text": "HELP!"
    },
    "w2": {
      "startSec": 29.177,
      "endSec": 29.776,
      "startFrame": 875,
      "endFrame": 893,
      "text": "NOW!"
    },
    "b12": {
      "startSec": 29.956,
      "endSec": 32.262,
      "startFrame": 899,
      "endFrame": 968,
      "text": "Mom ran the whole way, and stayed by her side."
    },
    "b13": {
      "startSec": 32.342,
      "endSec": 35.216,
      "startFrame": 970,
      "endFrame": 1056,
      "text": "My counter read ninety-eight. Worth every single word."
    },
    "b14": {
      "startSec": 35.336,
      "endSec": 38.151,
      "startFrame": 1060,
      "endFrame": 1145,
      "text": "But last night, she spent her first new word on me... 'hero'."
    }
  },
